{
  "id": "scenario_electric_heater_salt_steam",
  "name": "电加热器熔盐储热供汽计算场景",
  "category": "molten_salt_steam",
  "description": "该项目为电加热器熔盐储热供汽工程场景。利用夜间低谷电价时段启动电阻式电加热器将熔盐加热储存，储热时长通常为8h；在白天用热时段通过熔盐蒸汽发生系统（SGS）连续供应工业蒸汽。实现源侧/用户侧削峰填谷、消纳低成本绿电或谷电、替代燃煤燃气锅炉供汽。",
  "notes": "1. 供汽时长与谷电时长已完全解耦，若时长不等，系统将依据能量守恒自动折算电加热功率；\n2. 默认采用中温 HITEC 三元盐（190~390℃），若工况为超临界或超高温蒸汽，需切换为太阳盐温区；\n3. 本流程经营毛利未扣减水耗、厂用动力电及人工折旧，深度财务测算待后续扩展。",
  "required_inputs": [
    {
      "name": "steam_pressure",
      "unit": "MPa",
      "description": "蒸汽绝对工作压力（默认 1.5 MPa）",
      "min_value": 0.1,
      "max_value": 25.0,
      "default_value": 1.5,
      "kind": "input"
    },
    {
      "name": "steam_temperature",
      "unit": "℃",
      "description": "蒸汽供汽温度（默认 200 ℃）",
      "min_value": 100.0,
      "max_value": 600.0,
      "default_value": 200.0,
      "kind": "input"
    },
    {
      "name": "steam_mass_flow",
      "unit": "t/h",
      "description": "额定蒸汽流量（默认 100 t/h）",
      "min_value": 0.1,
      "max_value": 2000.0,
      "default_value": 100.0,
      "kind": "input"
    },
    {
      "name": "feedwater_pressure",
      "unit": "MPa",
      "description": "锅炉/换热器给水绝对压力（默认 0.1 MPa）",
      "min_value": 0.05,
      "max_value": 25.0,
      "default_value": 0.1,
      "kind": "input"
    },
    {
      "name": "feedwater_temperature",
      "unit": "℃",
      "description": "给水温度（默认 20 ℃）",
      "min_value": 5.0,
      "max_value": 150.0,
      "default_value": 20.0,
      "kind": "input"
    },
    {
      "name": "steam_supply_hours",
      "unit": "h",
      "description": "每日连续供汽时长（默认 8 h）",
      "min_value": 1.0,
      "max_value": 24.0,
      "default_value": 8.0,
      "kind": "input"
    },
    {
      "name": "valley_electricity_hours",
      "unit": "h",
      "description": "每日谷电蓄热时长（默认 8 h，与供汽时长解耦）",
      "min_value": 1.0,
      "max_value": 24.0,
      "default_value": 8.0,
      "kind": "input"
    },
    {
      "name": "annual_operating_days",
      "unit": "d",
      "description": "年有效运行天数（默认 330 天）",
      "min_value": 50.0,
      "max_value": 365.0,
      "default_value": 330.0,
      "kind": "input"
    },
    {
      "name": "electric_heater_efficiency",
      "unit": "/",
      "description": "电加热器电热转换综合效率（默认 0.985）",
      "min_value": 0.8,
      "max_value": 1.0,
      "default_value": 0.985,
      "kind": "constant"
    },
    {
      "name": "heat_exchanger_efficiency",
      "unit": "/",
      "description": "SGS换热器换热综合效率（默认 0.99）",
      "min_value": 0.8,
      "max_value": 1.0,
      "default_value": 0.99,
      "kind": "constant"
    },
    {
      "name": "thermal_storage_efficiency",
      "unit": "/",
      "description": "熔盐储热罐保温与储热效率（默认 0.99）",
      "min_value": 0.8,
      "max_value": 1.0,
      "default_value": 0.99,
      "kind": "constant"
    },
    {
      "name": "salt_hot_temperature",
      "unit": "℃",
      "description": "储热高温熔盐温度（HITEC盐默认 390 ℃）",
      "min_value": 180.0,
      "max_value": 600.0,
      "default_value": 390.0,
      "kind": "input"
    },
    {
      "name": "salt_cold_temperature",
      "unit": "℃",
      "description": "储热低温熔盐温度（HITEC盐默认 190 ℃）",
      "min_value": 150.0,
      "max_value": 450.0,
      "default_value": 190.0,
      "kind": "input"
    },
    {
      "name": "salt_specific_heat",
      "unit": "kJ/(kg·℃)",
      "description": "熔盐平均比热容（HITEC盐基准值 1.42 kJ/(kg·℃)）",
      "min_value": 1.0,
      "max_value": 2.5,
      "default_value": 1.42,
      "kind": "constant"
    },
    {
      "name": "salt_safety_margin",
      "unit": "/",
      "description": "熔盐设计安全冗余系数（默认 1.10）",
      "min_value": 1.0,
      "max_value": 1.5,
      "default_value": 1.1,
      "kind": "constant"
    },
    {
      "name": "valley_electricity_price",
      "unit": "元/kWh",
      "description": "当地低谷电价（元/度，典型工业低谷电价 0.25~0.35 元/度）",
      "min_value": -0.1,
      "max_value": 2.0,
      "default_value": 0.3,
      "kind": "input"
    },
    {
      "name": "steam_market_price",
      "unit": "元/t",
      "description": "当地工业蒸汽市售价格（元/吨，典型 150~220 元/吨）",
      "min_value": 50.0,
      "max_value": 600.0,
      "default_value": 180.0,
      "kind": "input"
    }
  ],
  "steps": [
    {
      "step_id": "step_1_steam_enthalpy",
      "formula_id": "thermal.steam_enthalpy",
      "solve_target": null,
      "input_map": {
        "steam_pressure": "steam_pressure",
        "steam_temperature": "steam_temperature"
      },
      "output_map": {
        "steam_enthalpy": "steam_enthalpy"
      },
      "description": "根据蒸汽压力和温度，基于 IAPWS-95 物性库查表计算蒸汽比焓"
    },
    {
      "step_id": "step_2_water_enthalpy",
      "formula_id": "thermal.water_enthalpy",
      "solve_target": null,
      "input_map": {
        "feedwater_pressure": "feedwater_pressure",
        "feedwater_temperature": "feedwater_temperature"
      },
      "output_map": {
        "feedwater_enthalpy": "feedwater_enthalpy"
      },
      "description": "根据给水压力和温度，基于 IAPWS-95 物性库查表计算给水比焓"
    },
    {
      "step_id": "step_3_enthalpy_diff",
      "formula_id": "thermal.enthalpy_diff",
      "solve_target": null,
      "input_map": {
        "steam_enthalpy": "steam_enthalpy",
        "feedwater_enthalpy": "feedwater_enthalpy"
      },
      "output_map": {
        "enthalpy_diff": "enthalpy_diff"
      },
      "description": "计算水相变为目标参数蒸汽所需的有效比焓增量（焓差）"
    },
    {
      "step_id": "step_4_theoretical_power",
      "formula_id": "thermal.theoretical_power",
      "solve_target": null,
      "input_map": {
        "steam_mass_flow": "steam_mass_flow",
        "enthalpy_diff": "enthalpy_diff"
      },
      "output_map": {
        "theoretical_power": "theoretical_power"
      },
      "description": "根据额定蒸汽流量与进出口焓差，计算产生蒸汽所需的理论净吸热功率（MWt）"
    },
    {
      "step_id": "step_5_sgs_power",
      "formula_id": "thermal.sgs_power",
      "solve_target": null,
      "input_map": {
        "theoretical_power": "theoretical_power",
        "heat_exchanger_efficiency": "heat_exchanger_efficiency"
      },
      "output_map": {
        "sgs_power": "sgs_power"
      },
      "description": "计入换热损失后，折算SGS换热器侧实际需要的换热热功率（MWt）"
    },
    {
      "step_id": "step_6_steam_heat_supply",
      "formula_id": "thermal.steam_heat_supply",
      "solve_target": null,
      "input_map": {
        "sgs_power": "sgs_power",
        "steam_supply_hours": "steam_supply_hours"
      },
      "output_map": {
        "steam_heat_supply": "steam_heat_supply"
      },
      "description": "结合供汽时长，将SGS换热功率转换为供汽周期累计释放的总热能（MWh）"
    },
    {
      "step_id": "step_7_thermal_storage_capacity",
      "formula_id": "thermal.thermal_storage_capacity",
      "solve_target": null,
      "input_map": {
        "steam_heat_supply": "steam_heat_supply",
        "thermal_storage_efficiency": "thermal_storage_efficiency"
      },
      "output_map": {
        "thermal_storage_capacity": "thermal_storage_capacity"
      },
      "description": "计入储罐保温与散热损失，计算储热系统额定储热容量（MWht）"
    },
    {
      "step_id": "step_8_electric_heater_power",
      "formula_id": "thermal.electric_heater_power",
      "solve_target": null,
      "input_map": {
        "thermal_storage_capacity": "thermal_storage_capacity",
        "valley_electricity_hours": "valley_electricity_hours",
        "electric_heater_efficiency": "electric_heater_efficiency"
      },
      "output_map": {
        "electric_heater_power": "electric_heater_power"
      },
      "description": "基于总能量守恒与谷电蓄热时长窗口，折算电加热器额定电功率（MWe）"
    },
    {
      "step_id": "step_9_molten_salt_mass",
      "formula_id": "thermal.molten_salt_mass",
      "solve_target": null,
      "input_map": {
        "thermal_storage_capacity": "thermal_storage_capacity",
        "salt_specific_heat": "salt_specific_heat",
        "salt_hot_temperature": "salt_hot_temperature",
        "salt_cold_temperature": "salt_cold_temperature",
        "salt_safety_margin": "salt_safety_margin"
      },
      "output_map": {
        "salt_mass": "salt_mass"
      },
      "description": "根据储热容量、熔盐高低温差、定压比热容及安全冗余系数确定理论熔盐净重"
    },
    {
      "step_id": "step_10_salt_mass_roundup",
      "formula_id": "sizing.salt_mass_roundup",
      "solve_target": null,
      "input_map": {
        "salt_mass": "salt_mass"
      },
      "output_map": {
        "salt_mass_tons": "salt_mass_tons"
      },
      "description": "理论熔盐净重向上圆整至整 10 吨采购订货量"
    },
    {
      "step_id": "step_11_daily_electricity",
      "formula_id": "operation.daily_electricity",
      "solve_target": null,
      "input_map": {
        "electric_heater_power": "electric_heater_power",
        "valley_electricity_hours": "valley_electricity_hours"
      },
      "output_map": {
        "daily_power_mwh": "daily_power_mwh"
      },
      "description": "计算每日消纳低谷电用电量（MWh/d）"
    },
    {
      "step_id": "step_12_annual_electricity",
      "formula_id": "operation.annual_electricity",
      "solve_target": null,
      "input_map": {
        "daily_power_mwh": "daily_power_mwh",
        "annual_operating_days": "annual_operating_days"
      },
      "output_map": {
        "annual_power_wan_kwh": "annual_power_wan_kwh"
      },
      "description": "按年有效运营天数测算年累计用电量（万kWh/年）"
    },
    {
      "step_id": "step_13_daily_steam_production",
      "formula_id": "operation.daily_steam_production",
      "solve_target": null,
      "input_map": {
        "steam_mass_flow": "steam_mass_flow",
        "steam_supply_hours": "steam_supply_hours"
      },
      "output_map": {
        "daily_steam_tons": "daily_steam_tons"
      },
      "description": "计算每日累计外供蒸汽吨数（t/d）"
    },
    {
      "step_id": "step_14_annual_steam_production",
      "formula_id": "operation.annual_steam_production",
      "solve_target": null,
      "input_map": {
        "daily_steam_tons": "daily_steam_tons",
        "annual_operating_days": "annual_operating_days"
      },
      "output_map": {
        "annual_steam_wan_tons": "annual_steam_wan_tons"
      },
      "description": "测算年累计外供蒸汽量（万t/年）"
    },
    {
      "step_id": "step_15_daily_electricity_cost",
      "formula_id": "operation.daily_electricity_cost",
      "solve_target": null,
      "input_map": {
        "daily_power_mwh": "daily_power_mwh",
        "valley_electricity_price": "valley_electricity_price"
      },
      "output_map": {
        "daily_electricity_cost": "daily_electricity_cost"
      },
      "description": "计算每日谷电购电费用支出（元/d）"
    },
    {
      "step_id": "step_16_daily_steam_revenue",
      "formula_id": "operation.daily_steam_revenue",
      "solve_target": null,
      "input_map": {
        "daily_steam_tons": "daily_steam_tons",
        "steam_market_price": "steam_market_price"
      },
      "output_map": {
        "daily_steam_revenue": "daily_steam_revenue"
      },
      "description": "计算每日外供蒸汽营业收入（元/d）"
    },
    {
      "step_id": "step_17_daily_operating_spread",
      "formula_id": "operation.daily_operating_spread",
      "solve_target": null,
      "input_map": {
        "daily_steam_revenue": "daily_steam_revenue",
        "daily_electricity_cost": "daily_electricity_cost"
      },
      "output_map": {
        "daily_operating_spread": "daily_operating_spread"
      },
      "description": "计算日度售汽收入与低谷购电成本的毛利差额（元/d）"
    }
  ],
  "layout": {},
  "input_constraints": []
}
