{
  "id": "operation.daily_steam_revenue",
  "name": "每日售汽收入计算",
  "category": "operation",
  "description": "根据日供汽吨数与市售蒸汽单价，计算每日售汽营业额（元/d）。",
  "notes": "",
  "formula_type": "algebraic",
  "inputs": [
    {
      "name": "daily_steam_tons",
      "unit": "t",
      "description": "每日供汽总量",
      "min_value": 0.1,
      "max_value": 48000.0,
      "default_value": null,
      "kind": "input"
    },
    {
      "name": "steam_market_price",
      "unit": "元/t",
      "description": "蒸汽市售单价",
      "min_value": 20.0,
      "max_value": 1000.0,
      "default_value": 180.0,
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "daily_steam_revenue",
      "unit": "元",
      "description": "每日售汽营业收入",
      "min_value": 1.0,
      "max_value": 50000000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "expression": "daily_steam_revenue = daily_steam_tons * steam_market_price",
  "is_bidirectional": true
}
