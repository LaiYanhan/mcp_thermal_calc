{
  "id": "operation.annual_operating_spread",
  "name": "年化经营毛收益差额测算",
  "category": "operation",
  "description": "按年有效运营天数将日度毛利差额折算为年化经营毛利（万元/年）。",
  "notes": "未扣除除盐水水费、厂用动力电及设备折旧人工。",
  "formula_type": "algebraic",
  "inputs": [
    {
      "name": "daily_operating_spread",
      "unit": "元",
      "description": "每日经营毛收益差额",
      "min_value": -10000000.0,
      "max_value": 50000000.0,
      "default_value": null,
      "kind": "input"
    },
    {
      "name": "annual_operating_days",
      "unit": "d",
      "description": "年运行天数",
      "min_value": 50.0,
      "max_value": 365.0,
      "default_value": 330.0,
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "annual_operating_spread_wan",
      "unit": "万元",
      "description": "年化经营毛收益差额",
      "min_value": -10000.0,
      "max_value": 100000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "expression": "annual_operating_spread_wan = daily_operating_spread * annual_operating_days / 10000",
  "is_bidirectional": true
}
