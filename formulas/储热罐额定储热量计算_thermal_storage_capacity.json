{
  "id": "thermal.thermal_storage_capacity",
  "name": "储热罐额定储热量计算",
  "category": "thermal",
  "description": "供汽期总吸热能量计入储罐保温散热与储热循环损失后，储罐所需储存的总热能量（MWht）。",
  "notes": "",
  "formula_type": "algebraic",
  "inputs": [
    {
      "name": "steam_heat_supply",
      "unit": "MWh",
      "description": "每日供汽总释热量",
      "min_value": 0.1,
      "max_value": 50000.0,
      "default_value": null,
      "kind": "input"
    },
    {
      "name": "thermal_storage_efficiency",
      "unit": "/",
      "description": "储热罐保温与储热效率",
      "min_value": 0.8,
      "max_value": 1.0,
      "default_value": 0.99,
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "thermal_storage_capacity",
      "unit": "MWh",
      "description": "储热罐额定储热容量",
      "min_value": 0.1,
      "max_value": 60000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "expression": "thermal_storage_capacity = steam_heat_supply / thermal_storage_efficiency",
  "is_bidirectional": true
}
