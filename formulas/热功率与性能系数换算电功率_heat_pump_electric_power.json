{
  "id": "thermal.heat_pump_electric_power",
  "name": "热功率与性能系数换算电功率",
  "category": "thermal",
  "description": "热功率与性能系数换算电功率，适用于具有相同量纲和关系的计算节点。",
  "notes": "供汽时长与谷电时长已解耦，基于总储热能量除以谷电时长折算。",
  "formula_type": "algebraic",
  "inputs": [
    {
      "name": "heat_pump_thermal_power",
      "unit": "MWt",
      "description": "热泵输出热功率",
      "min_value": 0.1,
      "max_value": 2000.0,
      "default_value": null,
      "kind": "input"
    },
    {
      "name": "heat_pump_cop",
      "unit": "/",
      "description": "热泵COP",
      "min_value": 1.0,
      "max_value": 10.0,
      "default_value": 1.5,
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "heat_pump_electric_power",
      "unit": "MWe",
      "description": "热泵输入电功率",
      "min_value": 0.1,
      "max_value": 2000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "expression": "heat_pump_electric_power = heat_pump_thermal_power / heat_pump_cop",
  "is_bidirectional": true
}
