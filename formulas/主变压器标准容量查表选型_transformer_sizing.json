{
  "id": "sizing.transformer_sizing",
  "name": "主变压器标准容量查表选型",
  "category": "sizing",
  "description": "由场景内标准容量表向上选档；有功功率须先按场景功率因数换算为视在容量。",
  "notes": "表外取首末行；多台设备组合须另行显式建模。",
  "formula_type": "empirical",
  "inputs": [
    {
      "name": "value",
      "unit": "MVA",
      "description": "所需视在容量",
      "min_value": 1.0,
      "max_value": 2000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "result",
      "unit": "MVA",
      "description": "主变压器标准额定容量",
      "min_value": 6.3,
      "max_value": 5000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "expression": null,
  "is_bidirectional": false,
  "handler": "data.discrete",
  "data_inputs": [
    {
      "name": "table",
      "rule_type": "discrete",
      "input_unit": "MVA",
      "output_unit": "MVA"
    }
  ]
}
