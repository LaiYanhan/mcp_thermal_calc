{
  "id": "operation.annual_steam_production",
  "name": "年外供蒸汽总量计算",
  "category": "operation",
  "description": "根据每日供汽量与年运行天数，计算年累计供汽量（万t/年）。",
  "notes": "",
  "formula_type": "algebraic",
  "inputs": [
    {
      "name": "daily_steam_tons",
      "unit": "t",
      "description": "每日供汽总量",
      "min_value": 0.1,
      "max_value": 48000.0,
      "default_value": null,
      "kind": "input"
    },
    {
      "name": "annual_operating_days",
      "unit": "d",
      "description": "年运行天数",
      "min_value": 50.0,
      "max_value": 365.0,
      "default_value": 330.0,
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "annual_steam_wan_tons",
      "unit": "万t",
      "description": "年累计供汽总量",
      "min_value": 0.01,
      "max_value": 2000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "expression": "annual_steam_wan_tons = daily_steam_tons * annual_operating_days / 10000",
  "is_bidirectional": true
}
