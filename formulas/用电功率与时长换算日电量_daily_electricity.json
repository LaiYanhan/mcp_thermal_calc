{
  "id": "operation.daily_electricity",
  "name": "用电功率与时长换算日电量",
  "category": "operation",
  "description": "用电功率与时长换算日电量，适用于具有相同量纲和关系的计算节点。",
  "notes": "",
  "formula_type": "algebraic",
  "inputs": [
    {
      "name": "electric_heater_power",
      "unit": "MW",
      "description": "电加热器运行功率",
      "min_value": 0.1,
      "max_value": 2000.0,
      "default_value": null,
      "kind": "input"
    },
    {
      "name": "valley_electricity_hours",
      "unit": "h",
      "description": "每日谷电时长",
      "min_value": 0.5,
      "max_value": 24.0,
      "default_value": 8.0,
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "daily_power_mwh",
      "unit": "MWh",
      "description": "每日消纳谷电电量",
      "min_value": 0.1,
      "max_value": 48000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "expression": "daily_power_mwh = electric_heater_power * valley_electricity_hours",
  "is_bidirectional": true
}
