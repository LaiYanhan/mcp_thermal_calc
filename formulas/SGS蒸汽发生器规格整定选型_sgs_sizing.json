{
  "id": "sizing.sgs_sizing",
  "name": "SGS蒸汽发生器规格整定选型",
  "category": "sizing",
  "description": "根据理论计算的 SGS 换热功率需求，按制造商标准化规格（每5MW为一档）向上圆整确定选型型号。",
  "notes": "按制造商5MW标准步长向上圆整。",
  "formula_type": "empirical",
  "inputs": [
    {
      "name": "sgs_power",
      "unit": "MW",
      "description": "SGS理论换热功率需求",
      "min_value": 0.1,
      "max_value": 2000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "sgs_sizing_mw",
      "unit": "MW",
      "description": "SGS标准选型规格",
      "min_value": 5.0,
      "max_value": 2000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "expression": null,
  "is_bidirectional": false,
  "handler": "sizing.sgs_power"
}
