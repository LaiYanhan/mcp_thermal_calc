{
  "id": "thermal.steam_enthalpy",
  "name": "蒸汽焓值查表计算",
  "category": "thermal",
  "description": "基于 IAPWS-95 国际水蒸气热力学科学基准状态方程，根据蒸汽工作压力与温度确定过热/饱和蒸汽比焓值。",
  "notes": "输入压力必须换算为绝对工作压力；若为湿饱和蒸汽需关注干度，目前默认过热或饱和单相蒸汽区。",
  "formula_type": "empirical",
  "inputs": [
    {
      "name": "steam_pressure",
      "unit": "MPa",
      "description": "蒸汽绝对工作压力（MPa）",
      "min_value": 0.1,
      "max_value": 25.0,
      "default_value": 1.5,
      "kind": "input"
    },
    {
      "name": "steam_temperature",
      "unit": "℃",
      "description": "蒸汽工作温度（℃）",
      "min_value": 100.0,
      "max_value": 600.0,
      "default_value": 200.0,
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "steam_enthalpy",
      "unit": "kJ/kg",
      "description": "蒸汽比焓（kJ/kg）",
      "min_value": 1000.0,
      "max_value": 4000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "expression": null,
  "is_bidirectional": false,
  "handler": "iapws95.steam_enthalpy"
}
