{
  "id": "thermal.sgs_power",
  "name": "SGS蒸汽发生器换热功率计算",
  "category": "thermal",
  "description": "计入换热器换热损失后，实际生产蒸汽所需的SGS换热器侧热功率（MWt）。",
  "notes": "",
  "formula_type": "algebraic",
  "inputs": [
    {
      "name": "theoretical_power",
      "unit": "MW",
      "description": "理论产汽功率",
      "min_value": 0.1,
      "max_value": 2000.0,
      "default_value": null,
      "kind": "input"
    },
    {
      "name": "heat_exchanger_efficiency",
      "unit": "/",
      "description": "换热综合效率",
      "min_value": 0.8,
      "max_value": 1.0,
      "default_value": 0.99,
      "kind": "input"
    }
  ],
  "outputs": [
    {
      "name": "sgs_power",
      "unit": "MW",
      "description": "SGS实际换热功率",
      "min_value": 0.1,
      "max_value": 2000.0,
      "default_value": null,
      "kind": "input"
    }
  ],
  "expression": "sgs_power = theoretical_power / heat_exchanger_efficiency",
  "is_bidirectional": true
}
